# Copy this file to .env.local for local development.
# On Vercel, set GEMINI_API_KEY under Project Settings -> Environment Variables instead —
# never commit a real key to this file or to git.

GEMINI_API_KEY=your-gemini-api-key-here

# "Send to CMS as draft" (server-only; set in Vercel, never commit real values)
MAINSITE_URL=https://cms.callboxinc.com
MAIN_CLIENT_USERNAME=wordpress-username
MAIN_CLIENT_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Optional
WP_REVAMP_TEMPLATE=template-case-study-revamp.php
# Optional override. Without it, drafts go under the page titled "Callbox Lead Generation Success Stories"
# (else the page with slug "case-studies").
WP_CASE_STUDY_PARENT_ID=

# App login (HTTP Basic Auth for every page and /api route). Use a long random password.
DRAFT_USER=callbox
DRAFT_PS=change-me-to-a-long-random-password

# "Import from CallboxOne" (server-only). Read-only use of the CallboxOne MCP server.
CALLBOXONE_MCP_URL=https://your-callboxone-mcp-server/mcp
CALLBOXONE_TOKEN=pipeline-personal-access-token

# "Import client from HubSpot" (server-only). Service Key on Callbox's own portal with only
# crm.objects.deals.read and crm.objects.companies.read. Deal amounts are never requested.
HUBSPOT_TOKEN=hubspot-service-key

# Brand logos on the start screen (public by design: the key only works on its registered domain).
# Vercel: the key for callbox-case-study-generator.vercel.app. .env.local: the key for localhost.
NEXT_PUBLIC_BRANDICONS_KEY=

# Weekly "most active clients" job (Vercel Schedules, Mondays 08:00 PH) and shared saved imports.
# CRON_SECRET: any long random string; Vercel Schedules send it to the /api/cron routes automatically.
CRON_SECRET=
# Supabase service role key (Project Settings > API). Server-only: it bypasses row level security,
# which the app_cache table needs because it has no public policies (supabase/app_cache.sql).
SUPABASE_SERVICE_ROLE_KEY=
